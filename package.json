{
  "name": "releaseguard-ai",
  "version": "0.1.0",
  "description": "Auditable AI agent for post-release incident investigation, evidence-based diagnosis, approval, and recovery verification.",
  "private": true,
  "license": "MIT",
  "homepage": "https://releaseguard.easonchao.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eason4real/releaseguard-ai.git"
  },
  "bugs": {
    "url": "https://github.com/Eason4real/releaseguard-ai/issues"
  },
  "keywords": [
    "ai-agent",
    "incident-investigation",
    "release-risk",
    "llm-evaluation",
    "human-in-the-loop"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:edgeone": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/production-bundle.test.mjs && node scripts/run-runtime-tests.mjs && node --test tests/rendered-html.test.mjs",
    "eval": "node scripts/run-runtime-tests.mjs && node scripts/run-rag-eval.mjs && node scripts/run-real-public-rag-eval.mjs && node scripts/run-phase4-eval.mjs",
    "eval:rag": "node scripts/run-rag-eval.mjs",
    "eval:rag:real": "node scripts/run-real-public-rag-eval.mjs",
    "eval:live": "node scripts/run-live-eval.mjs",
    "eval:investigation-dev-harness": "node scripts/run-investigation-benchmark-dev-harness.mjs",
    "eval:investigation-live": "node scripts/run-investigation-benchmark-live.mjs",
    "eval:investigation-rescore": "node scripts/run-investigation-benchmark-offline-rescore.mjs",
    "eval:dataset:freeze": "node scripts/export-releaseguard-evaluation-dataset.mjs",
    "eval:judge:portfolio": "node scripts/run-releaseguard-portfolio-final-blind-judge.mjs",
    "eval:smoke:input:v8": "node scripts/generate-releaseguard-v8-offline-smoke-input.mjs",
    "eval:smoke:validate:v8": "node --import tsx scripts/validate-releaseguard-v8-offline-smoke-input.mjs",
    "eval:smoke:audit:v8": "node --import tsx scripts/audit-releaseguard-v8-collector-policy.mjs",
    "eval:smoke:v8": "node --import tsx scripts/run-releaseguard-v8-offline-smoke.mjs",
    "eval:smoke:score:v8": "node --import tsx scripts/score-releaseguard-v8-offline-smoke.mjs",
    "eval:smoke:judge:v8": "node --import tsx scripts/run-releaseguard-v8-smoke-blind-judge.mjs",
    "corpus:import:public": "node scripts/run-public-corpus-import.mjs",
    "corpus:refresh:real": "node scripts/run-real-public-corpus-refresh.mjs",
    "corpus:validate:real": "node scripts/run-real-public-corpus-validation.mjs",
    "tsc": "tsc --noEmit",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
